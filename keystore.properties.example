# Copy this file to keystore.properties (which is gitignored) and fill in your own values.
# Never commit keystore.properties, a .jks/.keystore file, or any password.
# storeFile may be an absolute path (use forward slashes on Windows) or relative to the project root.
storeFile=C:/Users/<you>/keystores/applocker-release.jks
storePassword=
keyAlias=applocker
keyPassword=
