<?xml version="1.0" encoding="utf-8"?>
<!--
  A padlock, kept inside the 66dp centre of the 108dp adaptive-icon canvas so it survives every
  mask shape. The keyhole is cut out of the body, so the same drawable also works as the
  single-colour monochrome icon for themed icons on Android 13 and newer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Shackle -->
    <path
        android:pathData="M42,52 V44 A12,12 0 0 1 66,44 V52"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="butt" />
    <!-- Body with a keyhole cut out -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M39,52 H69 A5,5 0 0 1 74,57 V75 A5,5 0 0 1 69,80 H39 A5,5 0 0 1 34,75 V57 A5,5 0 0 1 39,52 Z M50,64 A4,4 0 1 1 58,64 A4,4 0 1 1 50,64 Z M52.5,66 H55.5 L56.5,74 H51.5 Z" />
</vector>
